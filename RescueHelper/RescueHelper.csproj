<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <PropertyGroup>
    <Version>0.1.1.0</Version>
    <Author>syberdamon</Author>
    <Name>Rescue Helper</Name>
    <Punchline>Healers: a party panel that shows who's standing in an AoE about to go off. Click to Rescue them, or let it Rescue automatically.</Punchline>
    <Description>Asks BossMod (Reborn) which spots are dangerous right now and checks each party member's position. Anyone standing in a danger zone that resolves within a few seconds turns red with a countdown. Click their row to Rescue them, or switch to automatic. It only Rescues when your own spot is safe, Rescue is ready and in range, and never pulls a tank holding enemies or a player carrying a mechanic marker (spread/stack). Needs BossMod or BossMod Reborn.</Description>
    <Tags>healer;rescue;aoe;bossmod</Tags>
    <RepoUrl>https://github.com/syberdamon/ffxiv-plugins</RepoUrl>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
</Project>
