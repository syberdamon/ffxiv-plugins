<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <PropertyGroup>
    <Version>0.1.11.0</Version>
    <Author>syberdamon</Author>
    <Name>Saucer Run</Name>
    <Punchline>One button for your Gold Saucer chores: Mini Cactpot, Jumbo Cactpot, and Triple Triad cards.</Punchline>
    <Description>A floating button shows whether today's Mini Cactpot and this week's Jumbo Cactpot are done. Click it and it learns any Triple Triad cards in your bags you don't have yet, teleports to the Gold Saucer, collects Jumbo Cactpot winnings and buys this week's tickets, plays the three Mini Cactpot tickets, then sells your spare cards to the Triple Triad Trader for MGP. The Cactpot games themselves (number picks, the scratch board) are left to Saucy, which must be installed with its Mini Cactpot and Jumbo Cactpot modules on. Walking uses vnavmesh. When the Cactpots are done, the button just does cards. English client.</Description>
    <Tags>gold saucer;cactpot;triple triad;mgp;saucy;daily</Tags>
    <RepoUrl>https://github.com/syberdamon/ffxiv-plugins</RepoUrl>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
</Project>
